# ==============================================================================
# EcoStream 3R - Variables de Entorno de Configuración
# ==============================================================================

# --- Base de Datos PostgreSQL 16 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecostream_db
POSTGRES_USER=ecostream_user
POSTGRES_PASSWORD=ecostream_secure_pass
DATABASE_URL=postgres://ecostream_user:ecostream_secure_pass@localhost:5432/ecostream_db?sslmode=disable

# --- Administrador pgAdmin 4 ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ecostream.ucab.ve
PGADMIN_PASSWORD=admin123

# --- Control Plane (Go Gateway) ---
GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=50051
JWT_SECRET=super_secret_eco_jwt_key_ucab_2026_change_in_prod
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=*

# --- Data Plane (Rust Simulation Engine) ---
SIMULATION_HOST=0.0.0.0
SIMULATION_GRPC_PORT=50052
TICK_RATE_HZ=20
MAX_ROOMS_PER_WORKER=10
RECONNECT_GRACE_PERIOD_SECS=5

# --- Clientes ---
DEFAULT_GATEWAY_URL=http://localhost:8080
DEFAULT_SIMULATION_URL=localhost:50052
