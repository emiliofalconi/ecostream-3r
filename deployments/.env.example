# ==============================================================================
# EcoStream-3R — Plantilla de Configuración Local y Edge (Docker Compose)
# Copia este archivo a deployments/.env para personalizarlo
# ==============================================================================

# Base de Datos PostgreSQL (Efímera Local)
POSTGRES_DB=ecostream_db
POSTGRES_USER=ecostream_user
POSTGRES_PASSWORD=ecostream_secure_pass
POSTGRES_PORT=5432

# Caché Redis Local
REDIS_PORT=6379

# API Gateway Go (Control Plane)
GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=50051

# Motor de Simulación Rust Tokio (Data Plane 20 Hz)
SIMULATION_GRPC_PORT=50052
TICK_RATE_HZ=20
RECONNECT_GRACE_SECONDS=10

# Secretos Criptográficos Compartidos (Compatibles con Render)
JWT_SECRET=super_secret_eco_jwt_key_ucab_2026_change_in_prod
HMAC_SECRET=super_secret_eco_hmac_ticket_key_2026

# Descubrimiento ZeroConf mDNS en LAN
ENABLE_MDNS=true
MDNS_INSTANCE_NAME=EcoStream-Local

# Sincronización Post-Partida hacia Render Cloud
CLOUD_SYNC_ENABLED=true
CLOUD_GATEWAY_URL=https://ecostream-gateway.onrender.com
SYNC_SERVICE_KEY=super_secret_eco_hmac_ticket_key_2026
